generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String
  created_at    DateTime  @default(now())
  // Um usuário pode ter vários checkins relacionamento de 1 para N
  CheckIns      CheckIn[]

  @@map("users")
}

model CheckIn {
  id          String    @id @default(uuid())
  created_at  DateTime  @default(now())
  validate_at DateTime?

  // Relacionamento criado entre uma chekin e um usuário 1 para 1
  user    User   @relation(fields: [user_id], references: [id])
  user_id String

  // Relacionamento criado entre o chekin e uma academia 1 para 1
  gym    Gym    @relation(fields: [gym_id], references: [id])
  gym_id String

  @@map("check-ins")
}

model Gym {
  id          String    @id @default(uuid())
  title       String
  description String?
  phone       String?
  latitude    Decimal
  longitude   Decimal
  // Uma academia pode ter um ou vários checkins relacionamento de 1 para N
  CheckIns    CheckIn[]

  @@map("gyms")
}
